# Applies to builds whose context is the repository root -- today that is
# airflow/Dockerfile, which copies services/ and dbt/ wholesale. Without this,
# local credential files and build junk end up baked into the image.
#
# services/api/.dockerignore and services/frontend/.dockerignore govern their
# own builds; this file does not reach them.

# Credentials. services/api/.env.users holds plaintext account passwords.
.env
.env.*
**/.env
**/.env.*
.secrets/

# Virtualenvs and build output
.venv/
venv/
**/__pycache__/
**/*.pyc
.pytest_cache/
**/node_modules/
**/dist/

# Generated by dbt at runtime; the image builds its own
dbt/**/target/
dbt/**/logs/
dbt/**/dbt_packages/

# Local operational state
airflow/logs/
backups/
monitoring/chart-cache/
.git/
